---
import { getYoutubeEmbedUrl, getYoutubeThumbnailUrl } from "../utils/youtube";

interface Props {
  url: string;
  class?: string;
}

const { url, class: className = "" } = Astro.props;
const thumbnailUrl = getYoutubeThumbnailUrl(url);
const embedUrl = getYoutubeEmbedUrl(url);
---

{
  thumbnailUrl && (
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      onclick={`openVideoModal(event, '${embedUrl}')`}
      class="group relative block"
      aria-label="Voir la vidéo sur YouTube"
    >
      <img
        src={thumbnailUrl}
        alt="Vidéo YouTube"
        loading="lazy"
        class={`w-full object-cover border border-gray-200 ${className}`}
      />
      <span class="absolute inset-0 flex items-center justify-center">
        <svg
          viewBox="0 0 68 48"
          class="w-16 h-12 opacity-90 group-hover:opacity-100 transition-opacity"
          aria-hidden="true"
        >
          <path
            d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55C3.97 2.33 2.27 4.81 1.48 7.74.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z"
            fill="#f00"
          />
          <path d="M45 24 27 14v20" fill="#fff" />
        </svg>
      </span>
    </a>
  )
}
